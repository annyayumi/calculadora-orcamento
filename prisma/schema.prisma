// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  IT_SUPPORT
  COLLABORATOR
}

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  users     User[]
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  email     String   @unique
  password  String
  role      Role
  isActive  Boolean  @default(true)
  company   Company  @relation(fields: [companyId], references: [id])
  companyId String
  logs      Log[]
  createdAt DateTime @default(now())
}

model Log {
  id        String   @id @default(cuid())
  action    String
  detail    Json?
  userCode  String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
}