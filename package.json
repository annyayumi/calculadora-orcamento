{
    "name": "yagro-saas",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky",
        "prisma:migrate": "dotenv -e .env.local -- npx prisma migrate dev",
        "prisma:studio": "dotenv -e .env.local -- npx prisma studio",
        "prisma:generate": "dotenv -e .env.local -- npx prisma generate"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.4.0",
        "@prisma/adapter-neon": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@radix-ui/react-slot": "^1.3.0",
        "bcryptjs": "^3.0.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.21.0",
        "next": "16.2.9",
        "next-themes": "^0.4.6",
        "prisma": "^7.8.0",
        "radix-ui": "^1.6.0",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "react-hook-form": "^7.80.0",
        "shadcn": "^4.11.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/bcryptjs": "^2.4.6",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "dotenv-cli": "^11.0.0",
        "eslint": "^9",
        "eslint-config-next": "16.2.9",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "prettier": "3.8.4",
        "tailwindcss": "^4",
        "typescript": "^5"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,css,md}": [
            "prettier --write"
        ]
    },
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        }
    }
}
